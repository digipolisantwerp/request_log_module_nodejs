{
  "name": "@digipolis/request-log",
  "version": "1.1.0",
  "keywords": [
    "digipolis",
    "antwerpen",
    "log",
    "logger",
    "request-logger"
  ],
  "description": "Log express and external Requests in digipolis format",
  "main": "lib/index.js",
  "scripts": {
    "start": "node ./example/index.js",
    "test": "node --test --test-force-exit",
    "lint": "eslint \"**/*.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/*.mjs' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=./coverage/lcov.info --test-force-exit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/digipolisantwerp/request_log_module_nodejs.git"
  },
  "author": "Olivier Van den Mooter",
  "license": "MIT",
  "dependencies": {
    "@digipolis/log": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "jsonschema": "^1.5.0",
    "express": "^5.2.1",
    "globals": "^17.7.0",
    "sinon": "^22.0.0"
  }
}
